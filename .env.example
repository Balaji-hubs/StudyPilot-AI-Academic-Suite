# AI Study Planner — Environment Configuration Example

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key for Session Authentication (Change in production!)
JWT_SECRET=ai-study-planner-super-secret-key-change-in-prod-2026

# Relational Database Location
DATABASE_PATH=../data/study_planner.db

# Optional External AI API Key (Gemini / OpenAI compatible API)
# When left blank, StudyPilot AI uses the built-in intelligent heuristic engine
# which operates with zero external network dependencies and 100% data privacy.
AI_API_KEY=
AI_PROVIDER=gemini

# Application URL
APP_URL=http://localhost:5000
